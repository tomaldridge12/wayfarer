---
// The chapter list as a Minecraft inventory panel, grouped under the stages of the timeline.
import Icon from './Icon.astro';
import { guide } from '../data/repo';

interface Props { current: string }
const { current } = Astro.props;
const g = guide();
const href = (s: string) => (s === 'welcome' ? '/' : `/${s}/`);
const groups = [
  { id: 'none', name: 'Start here', item: 'compass', chapters: g.chapters.filter((c) => c.stage === 'none') },
  ...g.stages.map((s) => ({ id: s.id, name: s.name, item: s.item, chapters: g.chapters.filter((c) => c.stage === s.id) })),
].filter((grp) => grp.chapters.length > 0);
---
<aside class="side">
  <a class="brand" href="/">
    <Icon item="filled_map" size={40} />
    <span class="brand-text"><span class="brand-name">Wayfarer</span><span class="brand-sub">A guide for travellers</span></span>
  </a>
  <details class="toc" open>
  <summary class="toc-toggle">Contents <span class="toc-current">{g.chapters.find((c) => c.slug === current)?.title}</span></summary>
  <nav class="gui" aria-label="Chapters">
    {groups.map((grp) => (
      <section class="group" data-stage={grp.id}>
        <h2 class="group-title"><span class="slot"><Icon item={grp.item} size={16} /></span>{grp.name}</h2>
        <ul>
          {grp.chapters.map((c) => (
            <li>
              <a href={href(c.slug)} aria-current={c.slug === current ? 'page' : undefined} class:list={[{ planned: c.status === 'planned' }]}>
                {c.title}
                {c.status === 'planned' && <span class="tag">planned</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
  </details>
</aside>
<script is:inline>
  // Phones start with the contents folded; wider screens always show them.
  for (const d of document.querySelectorAll('details.toc')) if (matchMedia('(max-width: 900px)').matches) d.open = false;
</script>

<style>
  .side { position: sticky; top: 36px; display: flex; flex-direction: column; gap: 18px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; padding: 4px 6px; }
  .brand-text { display: flex; flex-direction: column; }
  .brand-name {
    font-family: var(--pixel); font-weight: 600; font-size: 2rem; line-height: 1; color: var(--mc-gold);
    text-shadow: 3px 3px 0 #3f2a00;
  }
  .brand-sub { font-family: var(--serif); font-style: italic; color: #cdb98f; font-size: 1rem; }

  /* The classic GUI panel: light top-left bevel, dark bottom-right, black outline. */
  .gui {
    background: var(--gui);
    padding: 14px 12px 8px;
    border: 3px solid #000;
    box-shadow: inset 3px 3px 0 var(--gui-light), inset -3px -3px 0 var(--gui-shadow);
    border-radius: 3px;
  }
  .group + .group { margin-top: 12px; }
  .group-title {
    margin: 0 0 6px; font-size: 0.95rem; font-weight: 400; color: #3f3f3f;
    display: flex; align-items: center; gap: 8px;
  }
  .group-title::before { display: none; }
  .slot {
    width: 24px; height: 24px; display: inline-grid; place-items: center;
    background: var(--slot);
    box-shadow: inset 2px 2px 0 var(--gui-dark), inset -2px -2px 0 var(--gui-light);
  }
  ul { list-style: none; margin: 0 0 4px; padding: 0; }
  li a {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 5px 10px;
    font-family: var(--pixel); font-size: 1rem; color: #262626; text-decoration: none;
    border: 2px solid transparent;
  }
  li a:hover { background: rgba(255, 255, 255, 0.35); }
  li a[aria-current='page'] {
    background: var(--tooltip);
    color: var(--mc-white);
    border-image: linear-gradient(var(--tooltip-edge-top), var(--tooltip-edge-bottom)) 1;
  }
  li a.planned { color: #5a5a5a; }
  li a[aria-current='page'].planned { color: var(--mc-gray); }
  .tag { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #7a7a7a; }
  .group[data-stage='iron'] .group-title { color: #4a4a4a; }

  .toc-toggle { display: none; }
  @media (min-width: 901px) {
    /* The fold only exists on phones. */
    .toc > summary { display: none; }
  }
  @media (max-width: 900px) {
    .side { position: static; }
    .toc-toggle {
      display: flex; align-items: center; justify-content: space-between; gap: 12px; cursor: pointer; list-style: none;
      background: var(--gui); padding: 10px 14px; border: 3px solid #000; border-radius: 3px;
      box-shadow: inset 3px 3px 0 var(--gui-light), inset -3px -3px 0 var(--gui-shadow);
      font-family: var(--pixel); color: #262626; font-size: 1.05rem;
    }
    .toc-toggle::-webkit-details-marker { display: none; }
    .toc-toggle::after { content: '\25BC'; font-size: 0.7rem; }
    .toc[open] .toc-toggle::after { content: '\25B2'; }
    .toc-current { margin-left: auto; color: #5a5a5a; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .toc[open] .gui { margin-top: 6px; }
    .gui { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 4px 16px; }
    .group + .group { margin-top: 0; }
  }
</style>
